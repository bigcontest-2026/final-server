{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent 2025 ten-group raw I5 population-composition reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "month",
    "survey_year",
    "spatial_unit",
    "region_code",
    "region_name",
    "area_code",
    "area_name",
    "dong_code",
    "index_name",
    "index_kind",
    "isolation_index",
    "i5_reference",
    "scale",
    "domain_scores",
    "population_20plus",
    "population_total",
    "population_basis",
    "group_weights",
    "group_populations",
    "national_survey_n_valid",
    "local_survey_n_valid",
    "local_survey_measured",
    "is_isolation_rate",
    "behavior_signals_included",
    "quality",
    "operational_alert_allowed",
    "source_contract",
    "source_index_version",
    "source_data_version",
    "limitations",
    "source_survey_profile_sha256",
    "source_mois_member_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "survey_area_isolation_index_10group_v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^survey_i5_10:2025:"
    },
    "month": {
      "enum": [
        "202507",
        "202508",
        "202509",
        "202510",
        "202511",
        "202512"
      ]
    },
    "survey_year": {
      "const": 2025
    },
    "spatial_unit": {
      "enum": [
        "sgg",
        "administrative_dong"
      ]
    },
    "region_code": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "region_name": {
      "type": "string",
      "minLength": 1
    },
    "area_code": {
      "type": "string",
      "pattern": "^([0-9]{5}|[0-9]{10})$"
    },
    "area_name": {
      "type": "string",
      "minLength": 1
    },
    "dong_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{10}$"
    },
    "index_name": {
      "const": "사회조사 기반 인구구성 고립취약성 참고지수(I5)"
    },
    "index_kind": {
      "const": "population_composition_weighted_survey_reference"
    },
    "isolation_index": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "i5_reference": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "higher_means"
      ],
      "properties": {
        "min": {
          "const": 0
        },
        "max": {
          "const": 100
        },
        "higher_means": {
          "const": "higher_reference_vulnerability"
        }
      }
    },
    "domain_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "E",
        "P",
        "O",
        "C",
        "U"
      ],
      "properties": {
        "E": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "P": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "O": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "C": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "U": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "population_20plus": {
      "type": "integer",
      "minimum": 1
    },
    "population_total": {
      "type": "integer",
      "minimum": 1
    },
    "population_basis": {
      "const": "MOIS_month_end_registered_population_20plus"
    },
    "group_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "남_20-29",
        "남_30-39",
        "남_40-49",
        "남_50-59",
        "남_60+",
        "여_20-29",
        "여_30-39",
        "여_40-49",
        "여_50-59",
        "여_60+"
      ],
      "properties": {
        "남_20-29": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "남_30-39": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "남_40-49": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "남_50-59": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "남_60+": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "여_20-29": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "여_30-39": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "여_40-49": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "여_50-59": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "여_60+": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "group_populations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "남_20-29",
        "남_30-39",
        "남_40-49",
        "남_50-59",
        "남_60+",
        "여_20-29",
        "여_30-39",
        "여_40-49",
        "여_50-59",
        "여_60+"
      ],
      "properties": {
        "남_20-29": {
          "type": "integer",
          "minimum": 0
        },
        "남_30-39": {
          "type": "integer",
          "minimum": 0
        },
        "남_40-49": {
          "type": "integer",
          "minimum": 0
        },
        "남_50-59": {
          "type": "integer",
          "minimum": 0
        },
        "남_60+": {
          "type": "integer",
          "minimum": 0
        },
        "여_20-29": {
          "type": "integer",
          "minimum": 0
        },
        "여_30-39": {
          "type": "integer",
          "minimum": 0
        },
        "여_40-49": {
          "type": "integer",
          "minimum": 0
        },
        "여_50-59": {
          "type": "integer",
          "minimum": 0
        },
        "여_60+": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "group_profiles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sex",
          "age_group",
          "i5_reference",
          "domain_scores",
          "national_survey_n_valid",
          "reference_kind",
          "local_survey_measured",
          "population",
          "population_share",
          "survey_weight_sum"
        ],
        "properties": {
          "sex": {
            "enum": [
              "남",
              "여"
            ]
          },
          "age_group": {
            "enum": [
              "20-29",
              "30-39",
              "40-49",
              "50-59",
              "60+"
            ]
          },
          "i5_reference": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "domain_scores": {
            "$ref": "#/properties/domain_scores"
          },
          "national_survey_n_valid": {
            "type": "integer",
            "minimum": 1
          },
          "reference_kind": {
            "const": "national_survey_ten_group_mean"
          },
          "local_survey_measured": {
            "const": false
          },
          "population": {
            "type": "integer",
            "minimum": 0
          },
          "population_share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "survey_weight_sum": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "national_survey_n_valid": {
      "type": "integer",
      "minimum": 1
    },
    "local_survey_n_valid": {
      "const": null
    },
    "local_survey_measured": {
      "const": false
    },
    "is_isolation_rate": {
      "const": false
    },
    "behavior_signals_included": {
      "const": false
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "formula_verified"
      ],
      "properties": {
        "status": {
          "const": "reference_only"
        },
        "formula_verified": {
          "const": true
        }
      }
    },
    "operational_alert_allowed": {
      "const": false
    },
    "source_contract": {
      "const": "survey_mois_reference_10group_v1"
    },
    "source_index_version": {
      "const": "I5_2025_final_v1"
    },
    "source_data_version": {
      "const": "survey_area_i5_10group_2025_v1"
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_survey_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_mois_member_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "spatial_unit": {
            "const": "sgg"
          }
        }
      },
      "then": {
        "properties": {
          "area_code": {
            "pattern": "^[0-9]{5}$"
          },
          "dong_code": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "area_code": {
            "pattern": "^[0-9]{10}$"
          },
          "dong_code": {
            "type": "string",
            "pattern": "^[0-9]{10}$"
          }
        }
      }
    }
  ]
}
