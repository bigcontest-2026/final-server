                  },
                  "calendar_sensitivity": {
                    "$ref": "#/$defs/calendar"
                  },
                  "card_scope_sensitivity": {
                    "$ref": "#/$defs/scope"
                  },
                  "possible_explanations": {
                    "$ref": "#/$defs/stringArray"
                  },
                  "unverified_factors": {
                    "$ref": "#/$defs/stringArray"
                  }
                }
