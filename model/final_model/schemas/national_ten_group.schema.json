{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nationwide ten-group I5 survey reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sex",
    "age_group",
    "i5_reference",
    "domain_scores",
    "national_survey_n_valid",
    "survey_weight_sum",
    "reference_kind",
    "local_survey_measured"
  ],
  "properties": {
    "sex": {
      "enum": [
        "남",
        "여"
      ]
    },
    "age_group": {
      "enum": [
        "20-29",
        "30-39",
        "40-49",
        "50-59",
        "60+"
      ]
    },
    "i5_reference": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "domain_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "E",
        "P",
        "O",
        "C",
        "U"
      ],
      "properties": {
        "E": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "P": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "O": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "C": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "U": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "national_survey_n_valid": {
      "type": "integer",
      "minimum": 1
    },
    "survey_weight_sum": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "reference_kind": {
      "const": "national_survey_ten_group_mean"
    },
    "local_survey_measured": {
      "const": false
    }
  }
}
