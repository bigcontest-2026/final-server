APP_MODE=final
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Deployed welfare PostgreSQL (server only). URL takes precedence over SQLite.
# Copy the Session pooler URI from Supabase Connect; never place credentials in VITE_*.
# WELFARE_DATABASE_URL=postgresql://USER@HOST:5432/postgres?sslmode=require
# WELFARE_DATABASE_PASSWORD=""
# WELFARE_DATABASE_SCHEMA=welfare
# Optional UUID; unset selects the active published corpus for each source.
# WELFARE_PUBLICATION_ID=
# Without a remote URL, scripts/run_api.py keeps the local synthetic demo.
# WELFARE_DB_PATH=/absolute/path/to/welfare.sqlite
# Defaults resolve against the checkout. Paths must point to complete bundles.
# DONGHAENG_MODEL_ROOT=/absolute/path/to/model
# FINAL_MODEL_BUNDLE=/absolute/path/to/final_20261014_224511_915286
# I5_BUNDLE_PATH=/absolute/path/to/survey_area_index_run
# SURVEY_AREA_BUNDLE is a legacy alias; I5_BUNDLE_PATH takes precedence.
# MODEL_RUNTIME_ROOT=/absolute/path/to/local/final_model
# I5 defaults to model/data/i5/national_2025 before any old runtime pointer.
# Activity uses runtime pointers then model/final_model/outputs pointers.
# A bad configured bundle is rejected; it never falls back to an old snapshot.

# Optional legacy modes: install requirements-legacy.txt first.
# APP_MODE=research
# Backend-only development: install requirements-agent-dev.txt; use ChatGPT-authenticated Codex.
DONGHAENG_PROVIDER=codex_subscription
# Pin the validated CLI for the service; do not change the system CLI symlink.
# DONGHAENG_CODEX_BIN=/absolute/path/to/codex-0.163.0/bin/codex
# Leave DONGHAENG_MODEL unset to use the account default model.
DONGHAENG_CODEX_TIMEOUT_SECONDS=90
DONGHAENG_ANALYSIS_RESEARCH_TIMEOUT_SECONDS=120
# This provider is for local development only; institution API disables model strategies
# until an approved institution provider is implemented. No automatic API fallback.
# Start Phoenix locally first, then opt in to service lifecycle tracing:
# DONGHAENG_PHOENIX_ENABLED=true
# DONGHAENG_PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
# DONGHAENG_PHOENIX_PROJECT=hermes-development
# Default is false; readiness reports disabled/configured/unavailable and failures.
DONGHAENG_PHOENIX_ENABLED=false
# RESEARCH_PATH=/absolute/path/to/service/shared/research/isolation_snapshot.json
# Research mode also uses I5_BUNDLE_PATH, defaulting to the sibling model/data/i5/national_2025.
# DATASET_PATH=/absolute/path/to/service/shared/mock/dataset.json
# DONGHAENG_AGENT_ROOT=/absolute/path/to/agent
# OFFICIAL_SUPPORT_MANIFEST=/absolute/path/to/agent/resources/support/manifest.json
# OFFICIAL_SUPPORT_CAPTURE_ROOT=/absolute/path/to/agent/evidence/support
# INVESTIGATION_DB_PATH=/absolute/path/to/local/investigations.sqlite3
# INVESTIGATION_CHECKPOINT_PATH=/absolute/path/to/local/checkpoints.sqlite3
# INVESTIGATION_WORKER_ENABLED=true
# OPENAI_API_KEY=
# DONGHAENG_MODEL=

# Local development accepts loopback clients only. Do not expose it through a proxy.
ACCESS_MODE=local_development
# Institution mode fails closed unless every authentication setting is present.
# ACCESS_MODE=institution
# AUTH_JWT_ISSUER=https://institution-idp.example
# AUTH_JWT_AUDIENCE=hermes
# AUTH_TENANT_ID=institution-a
# AUTH_JWT_PUBLIC_KEY_PATH=/mounted/secrets/idp-rsa-public.pem
# AUTH_MAX_TOKEN_LIFETIME_SECONDS=3600
# Tokens must be RS256 with iss/aud/exp/iat/sub/tenant_id and permissions claims.
# Permissions: read, investigate, review, admin. Never put private signing keys here.
